--------------------------------------------------
-- BANK VAULT
-- IDENTITY SCANNER
-- CC:Tweaked + Advanced Peripherals
--------------------------------------------------

--------------------------------------------------
-- НАСТРОЙКИ
--------------------------------------------------

-- Разрешённые игроки
local AUTHORIZED_PLAYERS = {
    "4udomoloko",
    "katyo0haa"
}

-- Сторона редстоуна двери
local DOOR_SIDE = "bottom"

-- Радиус сканирования
local SCAN_RADIUS = 5

-- Длительность импульса открытия двери
local DOOR_PULSE_TIME = 0.2

-- Сколько секунд показывать результат
local MESSAGE_TIME = 5


--------------------------------------------------
-- ПОИСК PLAYER DETECTOR
--------------------------------------------------

local PLAYER = peripheral.find("playerDetector")

if not PLAYER then

    term.clear()
    term.setCursorPos(1, 1)

    print("ERROR:")
    print("Player Detector not found!")
    print()
    print("Connect an Advanced Peripherals")
    print("Player Detector to the computer.")

    return
end


--------------------------------------------------
-- ПРОВЕРКА РАЗРЕШЁННОГО ИГРОКА
--------------------------------------------------

local function isAuthorized(playerName)

    for i = 1, #AUTHORIZED_PLAYERS do

        if AUTHORIZED_PLAYERS[i] == playerName then
            return true
        end

    end

    return false
end


--------------------------------------------------
-- ОЧИСТКА ЭКРАНА
--------------------------------------------------

local function clearScreen()

    term.clear()
    term.setCursorPos(1, 1)

end


--------------------------------------------------
-- ЦЕНТРИРОВАНИЕ ТЕКСТА
--------------------------------------------------

local function center(text, y)

    local width = term.getSize()

    local x = math.floor(
        (width - #text) / 2
    ) + 1

    if x < 1 then
        x = 1
    end

    term.setCursorPos(x, y)
    term.write(text)

end


--------------------------------------------------
-- ГЛАВНЫЙ ЭКРАН
--------------------------------------------------

local function drawScannerScreen()

    clearScreen()

    local _, height = term.getSize()

    center("==============================", 2)
    center("BANK VAULT SYSTEM", 3)
    center("==============================", 4)

    center("IDENTITY SCANNER", 7)

    center("PRESS ENTER TO SCAN", 9)

    center("------------------------------", 11)

    center("AUTHORIZED PERSONNEL: 2", 13)

    center(
        "BANK SECURITY SYSTEM",
        height - 1
    )

end


--------------------------------------------------
-- ЭКРАН СКАНИРОВАНИЯ
--------------------------------------------------

local function drawScanningScreen()

    clearScreen()

    center("==============================", 4)
    center("IDENTITY SCAN", 6)
    center("==============================", 8)

    center("SCANNING...", 10)

end


--------------------------------------------------
-- ДОСТУП РАЗРЕШЁН
--------------------------------------------------

local function drawAccessGranted(playerName)

    clearScreen()

    local _, height = term.getSize()

    center("==============================", 4)
    center("IDENTITY VERIFIED", 6)
    center("==============================", 8)

    center("ACCESS GRANTED", 10)

    center(playerName, 12)

    center("VAULT DOOR OPEN", 14)

    center(
        "BANK SECURITY SYSTEM",
        height - 1
    )

end


--------------------------------------------------
-- ДОСТУП ЗАПРЕЩЁН
--------------------------------------------------

local function drawAccessDenied()

    clearScreen()

    local _, height = term.getSize()

    center("==============================", 4)
    center("IDENTITY REJECTED", 6)
    center("==============================", 8)

    center("ACCESS DENIED", 10)

    center("AUTHORIZED PERSONNEL", 12)

    center("NOT DETECTED", 14)

    center(
        "BANK SECURITY SYSTEM",
        height - 1
    )

end


--------------------------------------------------
-- НИКОГО НЕТ
--------------------------------------------------

local function drawNoPlayer()

    clearScreen()

    local _, height = term.getSize()

    center("==============================", 4)
    center("IDENTITY SCAN", 6)
    center("==============================", 8)

    center("NO PERSON DETECTED", 10)

    center("PLEASE STAND IN FRONT", 12)

    center("OF THE SCANNER", 14)

    center(
        "BANK SECURITY SYSTEM",
        height - 1
    )

end


--------------------------------------------------
-- ОТКРЫТИЕ ДВЕРИ
--------------------------------------------------

local function openDoor()

    -- Короткий импульс
    redstone.setOutput(
        DOOR_SIDE,
        true
    )

    sleep(DOOR_PULSE_TIME)

    redstone.setOutput(
        DOOR_SIDE,
        false
    )

end


--------------------------------------------------
-- СКАНИРОВАНИЕ ЛИЧНОСТИ
--------------------------------------------------

local function scanIdentity()

    drawScanningScreen()

    -- Небольшая задержка для эффекта сканирования
    sleep(0.5)

    --------------------------------------------------
    -- ПОЛУЧАЕМ ВСЕХ ИГРОКОВ В РАДИУСЕ
    --------------------------------------------------

    local players =
        PLAYER.getPlayersInRange(SCAN_RADIUS)

    if not players then
        players = {}
    end


    --------------------------------------------------
    -- НИКОГО НЕТ
    --------------------------------------------------

    if #players == 0 then

        drawNoPlayer()

        sleep(MESSAGE_TIME)

        return
    end


    --------------------------------------------------
    -- ИЩЕМ ХОТЯ БЫ ОДНОГО РАЗРЕШЁННОГО
    --
    -- ВАЖНО:
    -- остальные игроки НЕ МЕШАЮТ ДОСТУПУ.
    --------------------------------------------------

    local authorizedPlayer = nil

    for i = 1, #players do

        local playerName = players[i]

        if isAuthorized(playerName) then

            authorizedPlayer = playerName

            break
        end
    end


    --------------------------------------------------
    -- ЕСЛИ РАЗРЕШЁННЫЙ ИГРОК НАЙДЕН
    --------------------------------------------------

    if authorizedPlayer then

        drawAccessGranted(
            authorizedPlayer
        )

        openDoor()

        sleep(MESSAGE_TIME)

        return
    end


    --------------------------------------------------
    -- РАЗРЕШЁННОГО ИГРОКА НЕТ
    --------------------------------------------------

    drawAccessDenied()

    sleep(MESSAGE_TIME)

end


--------------------------------------------------
-- ЗАПУСК
--------------------------------------------------

-- При запуске сигнал двери выключен
redstone.setOutput(
    DOOR_SIDE,
    false
)


--------------------------------------------------
-- ГЛАВНЫЙ ЭКРАН
--------------------------------------------------

drawScannerScreen()


--------------------------------------------------
-- ГЛАВНЫЙ ЦИКЛ
--------------------------------------------------

while true do

    -- Ждём нажатия клавиши
    local event, key =
        os.pullEvent("key")

    --------------------------------------------------
    -- ENTER = ЗАПУСК СКАНИРОВАНИЯ
    --------------------------------------------------

    if key == keys.enter then

        scanIdentity()

        -- Возвращаем главный экран
        drawScannerScreen()

    end

end
