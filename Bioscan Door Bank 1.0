--------------------------------------------------
-- БАНКОВСКОЕ ХРАНИЛИЩЕ
-- СКАНЕР ЛИЧНОСТИ
-- CC:Tweaked + Advanced Peripherals
--------------------------------------------------

--------------------------------------------------
-- НАСТРОЙКИ
--------------------------------------------------

-- Два разрешённых игрока
local AUTHORIZED_PLAYERS = {
    "PlayerOne",
    "PlayerTwo"
}

-- Редстоун двери подключён снизу
local DOOR_SIDE = "bottom"

-- Радиус сканирования
local SCAN_RADIUS = 5

-- Длительность импульса открытия
local DOOR_PULSE_TIME = 0.2

-- Время показа результата
local MESSAGE_TIME = 5


--------------------------------------------------
-- ПОИСК ДЕТЕКТОРА ИГРОКОВ
--------------------------------------------------

local PLAYER = peripheral.find("playerDetector")

if not PLAYER then

    term.clear()
    term.setCursorPos(1, 1)

    print("ОШИБКА:")
    print("Детектор игрока не найден!")
    print()
    print("Подключите Player Detector")
    print("к компьютеру.")

    return
end


--------------------------------------------------
-- ПРОВЕРКА РАЗРЕШЁННОГО ИГРОКА
--------------------------------------------------

local function isAuthorized(playerName)

    for i = 1, #AUTHORIZED_PLAYERS do

        if AUTHORIZED_PLAYERS[i] == playerName then
            return true
        end

    end

    return false
end


--------------------------------------------------
-- ОЧИСТКА ЭКРАНА
--------------------------------------------------

local function clearScreen()

    term.clear()
    term.setCursorPos(1, 1)

end


--------------------------------------------------
-- ЦЕНТРИРОВАНИЕ
--------------------------------------------------

local function center(text, y)

    local width = term.getSize()

    local x = math.floor(
        (width - #text) / 2
    ) + 1

    if x < 1 then
        x = 1
    end

    term.setCursorPos(x, y)
    term.write(text)

end


--------------------------------------------------
-- ГЛАВНЫЙ ЭКРАН
--------------------------------------------------

local function drawScannerScreen()

    clearScreen()

    local _, height = term.getSize()

    center("==============================", 2)
    center("БАНКОВСКОЕ ХРАНИЛИЩЕ", 3)
    center("==============================", 4)

    center("СКАНЕР ЛИЧНОСТИ", 7)

    center("НАЖМИТЕ ENTER ДЛЯ СКАНА", 9)

    center("------------------------------", 11)

    center("ДОПУЩЕНО ПЕРСОН: 2", 13)

    center(
        "СИСТЕМА БЕЗОПАСНОСТИ БАНКА",
        height - 1
    )

end


--------------------------------------------------
-- ЭКРАН СКАНИРОВАНИЯ
--------------------------------------------------

local function drawScanningScreen()

    clearScreen()

    center("==============================", 4)
    center("СКАНИРОВАНИЕ ЛИЧНОСТИ", 6)
    center("==============================", 8)

    center("СКАНИРОВАНИЕ...", 10)

end


--------------------------------------------------
-- ДОСТУП РАЗРЕШЁН
--------------------------------------------------

local function drawAccessGranted(playerName)

    clearScreen()

    local _, height = term.getSize()

    center("==============================", 4)
    center("ЛИЧНОСТЬ ПОДТВЕРЖДЕНА", 6)
    center("==============================", 8)

    center("ДОСТУП РАЗРЕШЁН", 10)

    center(playerName, 12)

    center("ДВЕРЬ ОТКРЫТА", 14)

    center(
        "СИСТЕМА БЕЗОПАСНОСТИ БАНКА",
        height - 1
    )

end


--------------------------------------------------
-- ДОСТУП ЗАПРЕЩЁН
--------------------------------------------------

local function drawAccessDenied()

    clearScreen()

    local _, height = term.getSize()

    center("==============================", 4)
    center("ЛИЧНОСТЬ НЕ ПОДТВЕРЖДЕНА", 6)
    center("==============================", 8)

    center("ДОСТУП ЗАПРЕЩЁН", 10)

    center("ДОПУЩЕННЫЙ ПЕРСОНАЛ", 12)

    center("НЕ ОБНАРУЖЕН", 14)

    center(
        "СИСТЕМА БЕЗОПАСНОСТИ БАНКА",
        height - 1
    )

end


--------------------------------------------------
-- НИКТО НЕ ОБНАРУЖЕН
--------------------------------------------------

local function drawNoPlayer()

    clearScreen()

    local _, height = term.getSize()

    center("==============================", 4)
    center("СКАНИРОВАНИЕ ЛИЧНОСТИ", 6)
    center("==============================", 8)

    center("ИГРОК НЕ ОБНАРУЖЕН", 10)

    center("ВСТАНЬТЕ ПЕРЕД", 12)

    center("СКАНЕРОМ", 14)

    center(
        "СИСТЕМА БЕЗОПАСНОСТИ БАНКА",
        height - 1
    )

end


--------------------------------------------------
-- ОТКРЫТИЕ ДВЕРИ
--------------------------------------------------

local function openDoor()

    -- Короткий импульс
    redstone.setOutput(
        DOOR_SIDE,
        true
    )

    sleep(DOOR_PULSE_TIME)

    redstone.setOutput(
        DOOR_SIDE,
        false
    )

end


--------------------------------------------------
-- СКАНИРОВАНИЕ ЛИЧНОСТИ
--------------------------------------------------

local function scanIdentity()

    drawScanningScreen()

    sleep(0.5)

    --------------------------------------------------
    -- ПОЛУЧАЕМ ВСЕХ ИГРОКОВ В РАДИУСЕ
    --------------------------------------------------

    local players =
        PLAYER.getPlayersInRange(SCAN_RADIUS)

    if not players then
        players = {}
    end


    --------------------------------------------------
    -- НИКТО НЕ ОБНАРУЖЕН
    --------------------------------------------------

    if #players == 0 then

        drawNoPlayer()

        sleep(MESSAGE_TIME)

        return
    end


    --------------------------------------------------
    -- ИЩЕМ ХОТЯ БЫ ОДНОГО ДОПУЩЕННОГО
    --
    -- ПОСТОРОННИЕ ИГРОКИ НЕ МЕШАЮТ.
    --------------------------------------------------

    local authorizedPlayer = nil

    for i = 1, #players do

        local playerName = players[i]

        if isAuthorized(playerName) then

            authorizedPlayer = playerName

            break
        end
    end


    --------------------------------------------------
    -- ДОПУЩЕННЫЙ ИГРОК НАЙДЕН
    --------------------------------------------------

    if authorizedPlayer then

        drawAccessGranted(
            authorizedPlayer
        )

        openDoor()

        sleep(MESSAGE_TIME)

        return
    end


    --------------------------------------------------
    -- ДОПУЩЕННЫХ ИГРОКОВ НЕТ
    --------------------------------------------------

    drawAccessDenied()

    sleep(MESSAGE_TIME)

end


--------------------------------------------------
-- ЗАПУСК
--------------------------------------------------

redstone.setOutput(
    DOOR_SIDE,
    false
)


--------------------------------------------------
-- ГЛАВНЫЙ ЭКРАН
--------------------------------------------------

drawScannerScreen()


--------------------------------------------------
-- ГЛАВНЫЙ ЦИКЛ
--------------------------------------------------

while true do

    local event, key =
        os.pullEvent("key")

    if key == keys.enter then

        scanIdentity()

        drawScannerScreen()

    end

end
