-- ============================================
-- LIQUID COLOR FLOW
-- CC:Tweaked / CraftOS 1.9
-- ============================================

local monitor = peripheral.find("monitor")

if not monitor then
    error("No monitor found")
end

if not monitor.isColor() then
    error("Monitor does not support colors")
end

monitor.setTextScale(0.5)
monitor.setCursorBlink(false)

-- =========================
-- SETTINGS
-- =========================

local FRAME_DELAY = 0.1

local MIN_LINE_THICKNESS = 10
local MAX_LINE_THICKNESS = 16

local COLOR_SPEED = 3
local WAVE_SPEED = 5

-- =========================
-- COLORS
-- =========================

local COLORS = {
    colors.lightBlue,
    colors.blue,
    colors.cyan,
    colors.pink,
    colors.purple,
    colors.yellow,
    colors.orange
}

local COLOR_COUNT = #COLORS

-- =========================
-- CREATE MOVING CENTERS
-- =========================

local function createCenters(width, height)

    local centers = {}

    centers[1] = {
        x = width / 3,
        y = height / 2,
        dx = 0.10,
        dy = 0.08
    }

    centers[2] = {
        x = width * 2 / 3,
        y = height / 2,
        dx = -0.08,
        dy = 0.10
    }

    centers[3] = {
        x = width / 2,
        y = height / 3,
        dx = 0.07,
        dy = -0.09
    }

    centers[4] = {
        x = width / 2,
        y = height * 2 / 3,
        dx = -0.10,
        dy = -0.07
    }

    return centers
end

-- =========================
-- UPDATE CENTERS
-- =========================

local function updateCenters(centers, width, height)

    for i = 1, #centers do

        local center = centers[i]

        center.x = center.x + center.dx
        center.y = center.y + center.dy

        if center.x < 2 then
            center.x = 2
            center.dx = -center.dx
        elseif center.x > width - 2 then
            center.x = width - 2
            center.dx = -center.dx
        end

        if center.y < 2 then
            center.y = 2
            center.dy = -center.dy
        elseif center.y > height - 2 then
            center.y = height - 2
            center.dy = -center.dy
        end

    end
end

-- =========================
-- DRAW LIQUID
-- =========================

local function drawLiquid(time, centers, width, height)

    local phase = time / COLOR_SPEED
    local waveTime = time / WAVE_SPEED

    local thickness = MIN_LINE_THICKNESS
        + (MAX_LINE_THICKNESS - MIN_LINE_THICKNESS)
        * (0.5 + 0.5 * math.sin(time / 30))

    for y = 1, height do

        local text = string.rep(" ", width)
        local textColors = string.rep("0", width)
        local backgroundColors = ""

        for x = 1, width do

            local influence = 0

            for i = 1, #centers do

                local center = centers[i]

                local dx = x - center.x
                local dy = y - center.y

                local distance = math.sqrt(
                    dx * dx + dy * dy
                )

                local angle

                if dx == 0 then
                    if dy >= 0 then
                        angle = math.pi / 2
                    else
                        angle = -math.pi / 2
                    end
                else
                    angle = math.atan(dy / dx)

                    if dx < 0 then
                        angle = angle + math.pi
                    end
                end

                local wave = math.sin(
                    distance / thickness
                    - waveTime
                    + angle * 2
                )

                influence = influence + wave

            end

            local colorIndex = math.floor(
                influence * 2 + phase
            )

            colorIndex = (colorIndex % COLOR_COUNT) + 1

            local color = COLORS[colorIndex]

            -- Convert CC color value to blit hexadecimal digit.
            local blitColor = string.format(
                "%x",
                math.log(color, 2)
            )

            backgroundColors = backgroundColors .. blitColor

        end

        monitor.setCursorPos(1, y)

        monitor.blit(
            text,
            textColors,
            backgroundColors
        )
    end
end

-- =========================
-- INITIALIZATION
-- =========================

local width, height = monitor.getSize()

local centers = createCenters(
    width,
    height
)

local time = 0

monitor.setBackgroundColor(colors.black)
monitor.clear()

-- =========================
-- MAIN LOOP
-- =========================

while true do

    drawLiquid(
        time,
        centers,
        width,
        height
    )

    updateCenters(
        centers,
        width,
        height
    )

    time = time + 1

    sleep(FRAME_DELAY)

end
