Возьми этот код и сделай его удобочитаемым и легкоизменяемым для любого, кто захочет его себе, и пиши на английском всё 
-- Находим монитор
local mon = peripheral.find("monitor")
if not mon then error("Монитор не найден") end

-- Настройка
mon.setTextScale(0.5)
mon.setCursorBlink(false)

-- Палитра "жидких" цветов
local palette = {
    colors.lightBlue,
    colors.blue,
    colors.cyan,
    colors.pink,
    colors.purple,
    colors.yellow,
    colors.orange,
}

-- Получить цвет с циклом
local function getColor(i)
    i = (i - 1) % #palette + 1
    return palette[i]
end

-- Инициализация центров притяжения (быстрее, как в первой версии)
local function initCenters(w, h)
    return {
        {x = w / 3,     y = h / 2,     dx = 0.1,  dy = 0.08},
        {x = 2 * w / 3, y = h / 2,     dx = -0.08, dy = 0.1},
        {x = w / 2,     y = h / 3,     dx = 0.07, dy = -0.09},
        {x = w / 2,     y = 2 * h / 3, dx = -0.1, dy = -0.07},
    }
end

-- Обновление позиций центров
local function updateCenters(centers, w, h)
    for _, c in ipairs(centers) do
        c.x = c.x + c.dx
        c.y = c.y + c.dy

        -- отскок от краёв экрана
        if c.x < 2 or c.x > w - 2 then c.dx = -c.dx end
        if c.y < 2 or c.y > h - 2 then c.dy = -c.dy end
    end
end

-- Рисуем жидкий узор
local function drawLiquid(offset, centers)
    local w, h = mon.getSize()
    local baseThickness = 10 -- увеличили минимальную толщину

    for y = 1, h do
        mon.setCursorPos(1, y)
        for x = 1, w do
            local influence = 0

            for _, c in ipairs(centers) do
                local dx, dy = x - c.x, y - c.y
                local dist = math.sqrt(dx * dx + dy * dy)
                local angle = math.atan2(dy, dx)

                local thickness = math.max(baseThickness, 4 + 2 * math.sin(offset / 30))
                local wave = math.sin(dist / thickness - offset / 5 + angle * 2)

                influence = influence + wave
            end

            local colorIndex = math.floor(influence * 2 + offset / 3) % #palette + 1
            mon.setBackgroundColor(getColor(colorIndex))
            mon.write(" ")
        end
    end
end

-- Анимация
local w, h = mon.getSize()
local centers = initCenters(w, h)

local t = 0
while true do
    drawLiquid(t, centers)
    updateCenters(centers, w, h)
    t = t + 1
    sleep(0.1) -- вернули прежнюю скорость
end

