-- ============================================
-- LIQUID COLOR FLOW
-- CC:Tweaked / CraftOS 1.9
-- ============================================

-- =========================
-- MONITOR SETUP
-- =========================

local monitor = peripheral.find("monitor")

if not monitor then
    error("No monitor found")
end

monitor.setTextScale(0.5)
monitor.setCursorBlink(false)

local FRAME_DELAY = 0.1
local MIN_LINE_THICKNESS = 10
local COLOR_SPEED = 3
local WAVE_SPEED = 5

local COLORS = {
    colors.lightBlue,
    colors.blue,
    colors.cyan,
    colors.pink,
    colors.purple,
    colors.yellow,
    colors.orange
}

local function getColor(index)
    index = (index - 1) % #COLORS + 1
    return COLORS[index]
end

local function createCenters(width, height)
    local centers = {}

    centers[1] = {
        x = width / 3,
        y = height / 2,
        dx = 0.10,
        dy = 0.08
    }

    centers[2] = {
        x = width * 2 / 3,
        y = height / 2,
        dx = -0.08,
        dy = 0.10
    }

    centers[3] = {
        x = width / 2,
        y = height / 3,
        dx = 0.07,
        dy = -0.09
    }

    centers[4] = {
        x = width / 2,
        y = height * 2 / 3,
        dx = -0.10,
        dy = -0.07
    }

    return centers
end

local function updateCenters(centers, width, height)
    for _, center in ipairs(centers) do

        center.x = center.x + center.dx
        center.y = center.y + center.dy

        if center.x < 2 then
            center.x = 2
            center.dx = -center.dx
        end

        if center.x > width - 2 then
            center.x = width - 2
            center.dx = -center.dx
        end

        if center.y < 2 then
            center.y = 2
            center.dy = -center.dy
        end

        if center.y > height - 2 then
            center.y = height - 2
            center.dy = -center.dy
        end

    end
end

local function drawLiquid(time, centers)

    local width, height = monitor.getSize()

    for y = 1, height do

        monitor.setCursorPos(1, y)

        for x = 1, width do

            local influence = 0

            for _, center in ipairs(centers) do

                local dx = x - center.x
                local dy = y - center.y

                local distance = math.sqrt(
                    dx * dx + dy * dy
                )

                local angle = math.atan(dy, dx)

                local thickness = math.max(
                    MIN_LINE_THICKNESS,
                    4 + 2 * math.sin(time / 30)
                )

                local wave = math.sin(
                    distance / thickness
                    - time / WAVE_SPEED
                    + angle * 2
                )

                influence = influence + wave

            end

            local colorIndex = math.floor(
                influence * 2
                + time / COLOR_SPEED
            )

            colorIndex = (colorIndex % #COLORS) + 1

            monitor.setBackgroundColor(
                getColor(colorIndex)
            )

            monitor.write(" ")

        end
    end
end

local width, height = monitor.getSize()

local centers = createCenters(
    width,
    height
)

local time = 0

while true do

    drawLiquid(time, centers)

    updateCenters(
        centers,
        width,
        height
    )

    time = time + 1

    sleep(FRAME_DELAY)

end
