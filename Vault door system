local mon = peripheral.find("monitor")

if not mon then
    error("Монитор не найден")
end

mon.setTextScale(1)
mon.setCursorBlink(false)

-- ============================================
-- НАСТРОЙКА ДВЕРЕЙ
-- ============================================

local doors = {
    [1] = {
        name = "Дверь 1",
        side = "front"
    },

    [2] = {
        name = "Дверь 2",
        side = "left"
    },

    [3] = {
        name = "Дверь 3",
        side = "back"
    },

    [4] = {
        name = "Дверь 4",
        side = "right"
    }
}

-- ============================================
-- РАЗМЕР МОНИТОРА
-- ============================================

local width, height = mon.getSize()

-- ============================================
-- РИСОВАНИЕ КНОПОК
-- ============================================

local buttons = {}

local function drawButton(number, x, y, w, h)
    buttons[number] = {
        x1 = x,
        y1 = y,
        x2 = x + w - 1,
        y2 = y + h - 1
    }

    mon.setBackgroundColor(colors.gray)
    mon.setTextColor(colors.white)

    for yy = y, y + h - 1 do
        mon.setCursorPos(x, yy)
        mon.write(string.rep(" ", w))
    end

    local text = tostring(number)
    local tx = x + math.floor((w - #text) / 2)
    local ty = y + math.floor(h / 2)

    mon.setCursorPos(tx, ty)
    mon.setTextColor(colors.white)
    mon.write(text)
end

-- ============================================
-- ГЛАВНЫЙ ЭКРАН
-- ============================================

local function drawScreen()
    mon.setBackgroundColor(colors.black)
    mon.clear()

    buttons = {}

    -- Заголовок
    mon.setTextColor(colors.white)
    mon.setCursorPos(1, 1)

    local title = "ДВЕРИ"
    mon.write(title)

    -- Размер кнопок
    local buttonWidth = math.floor(width / 2) - 1
    local buttonHeight = math.floor((height - 2) / 2)

    -- Верхний ряд
    drawButton(
        1,
        1,
        3,
        buttonWidth,
        buttonHeight
    )

    drawButton(
        2,
        buttonWidth + 2,
        3,
        buttonWidth,
        buttonHeight
    )

    -- Нижний ряд
    drawButton(
        3,
        1,
        buttonHeight + 4,
        buttonWidth,
        buttonHeight
    )

    drawButton(
        4,
        buttonWidth + 2,
        buttonHeight + 4,
        buttonWidth,
        buttonHeight
    )
end

-- ============================================
-- ОТПРАВКА ИМПУЛЬСА
-- ============================================

local function openDoor(number)
    local door = doors[number]

    if not door then
        return
    end

    -- Подаём сигнал
    redstone.setOutput(door.side, true)

    -- Короткий импульс
    sleep(0.2)

    -- Убираем сигнал
    redstone.setOutput(door.side, false)
end

-- ============================================
-- ПРОВЕРКА НАЖАТИЯ
-- ============================================

local function getButton(x, y)
    for number, button in pairs(buttons) do
        if x >= button.x1
            and x <= button.x2
            and y >= button.y1
            and y <= button.y2 then

            return number
        end
    end

    return nil
end

-- ============================================
-- ЗАПУСК
-- ============================================

drawScreen()

while true do

    local event, side, x, y = os.pullEvent("monitor_touch")

    local number = getButton(x, y)

    if number then
        openDoor(number)

        -- Небольшая визуальная реакция
        mon.setBackgroundColor(colors.green)

        local button = buttons[number]

        for yy = button.y1, button.y2 do
            mon.setCursorPos(button.x1, yy)
            mon.write(string.rep(" ", button.x2 - button.x1 + 1))
        end

        local text = tostring(number)
        local tx = button.x1 + math.floor(
            ((button.x2 - button.x1 + 1) - #text) / 2
        )
        local ty = button.y1 + math.floor(
            ((button.y2 - button.y1 + 1) / 2)
        )

        mon.setCursorPos(tx, ty)
        mon.setTextColor(colors.white)
        mon.write(text)

        sleep(0.25)

        drawScreen()
    end
end
