-- ============================================

local mon = peripheral.find("monitor")

if not mon then
    error("Monitor not found")
end

mon.setTextScale(1)
mon.setCursorBlink(false)

-- ============================================
-- DOOR CONFIGURATION
-- ============================================

local doors = {
    [1] = "front",
    [2] = "left",
    [3] = "back",
    [4] = "right"
}

-- ============================================
-- MONITOR SIZE
-- ============================================

local width, height = mon.getSize()

-- ============================================
-- BUTTON SIZE
-- ============================================

local buttonWidth = 7
local buttonHeight = 3

-- ============================================
-- BUTTON POSITIONS
-- ============================================

local buttons = {
    [1] = {
        x = 2,
        y = math.floor(height / 2) - 1
    },

    [2] = {
        x = math.floor(width / 2) - 3,
        y = 2
    },

    [3] = {
        x = width - 8,
        y = math.floor(height / 2) - 1
    },

    [4] = {
        x = math.floor(width / 2) - 3,
        y = height - 4
    }
}

-- ============================================
-- DRAW BUTTON
-- ============================================

local function drawButton(number, active)

    local button = buttons[number]

    if active then
        mon.setBackgroundColor(colors.green)
    else
        mon.setBackgroundColor(colors.gray)
    end

    for y = button.y, button.y + buttonHeight - 1 do
        mon.setCursorPos(button.x, y)
        mon.write(string.rep(" ", buttonWidth))
    end

    mon.setTextColor(colors.white)

    local text = tostring(number)

    local textX =
        button.x
        + math.floor((buttonWidth - #text) / 2)

    local textY =
        button.y
        + math.floor((buttonHeight - 1) / 2)

    mon.setCursorPos(textX, textY)
    mon.write(text)
end

-- ============================================
-- DRAW SCREEN
-- ============================================

local function drawScreen()

    mon.setBackgroundColor(colors.black)
    mon.clear()

    -- Draw all four buttons
    drawButton(1, false)
    drawButton(2, false)
    drawButton(3, false)
    drawButton(4, false)
end

-- ============================================
-- CHECK BUTTON
-- ============================================

local function getButton(x, y)

    for number, button in pairs(buttons) do

        if x >= button.x
            and x < button.x + buttonWidth
            and y >= button.y
            and y < button.y + buttonHeight then

            return number
        end
    end

    return nil
end

-- ============================================
-- OPEN DOOR
-- ============================================

local function openDoor(number)

    local side = doors[number]

    if not side then
        return
    end

    -- Send short redstone pulse
    redstone.setOutput(side, true)

    sleep(0.2)

    redstone.setOutput(side, false)
end

-- ============================================
-- START
-- ============================================

drawScreen()

while true do

    local event, side, x, y =
        os.pullEvent("monitor_touch")

    local number = getButton(x, y)

    if number then

        -- Open door
        openDoor(number)

        -- Show pressed button
        drawButton(number, true)

        sleep(0.25)

        -- Restore screen
        drawScreen()
    end
end
