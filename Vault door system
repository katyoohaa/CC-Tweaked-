-- ============================================
-- 4 DOOR CONTROL
-- CC:TWEAKED / CRAFTOS 1.9
-- MONITOR: 15x10
-- ============================================

local mon = peripheral.find("monitor")

if not mon then
    error("Monitor not found")
end

mon.setTextScale(0.5)
mon.setCursorBlink(false)

-- ============================================
-- DOOR CONFIGURATION
-- ============================================

local doors = {
    [1] = "front",
    [2] = "left",
    [3] = "back",
    [4] = "right"
}

-- ============================================
-- BUTTON SIZE
-- ============================================

local buttonWidth = 3
local buttonHeight = 3

-- ============================================
-- BUTTON POSITIONS
-- ============================================

local buttons = {
    [1] = {
        x = 3,
        y = 4
    },

    [2] = {
        x = 7,
        y = 2
    },

    [3] = {
        x = 11,
        y = 4
    },

    [4] = {
        x = 7,
        y = 7
    }
}

-- ============================================
-- DRAW LARGE NUMBER
-- ============================================

local function drawButton(number, active)

    local button = buttons[number]

    if active then
        mon.setTextColor(colors.green)
    else
        mon.setTextColor(colors.red)
    end

    mon.setBackgroundColor(colors.black)

    -- Большая цифра 3x3
    if number == 1 then

        mon.setCursorPos(button.x, button.y)
        mon.write(" # ")

        mon.setCursorPos(button.x, button.y + 1)
        mon.write("## ")

        mon.setCursorPos(button.x, button.y + 2)
        mon.write("###")

    elseif number == 2 then

        mon.setCursorPos(button.x, button.y)
        mon.write("## ")

        mon.setCursorPos(button.x, button.y + 1)
        mon.write("###")

        mon.setCursorPos(button.x, button.y + 2)
        mon.write("###")

    elseif number == 3 then

        mon.setCursorPos(button.x, button.y)
        mon.write("## ")

        mon.setCursorPos(button.x, button.y + 1)
        mon.write("###")

        mon.setCursorPos(button.x, button.y + 2)
        mon.write("## ")

    elseif number == 4 then

        mon.setCursorPos(button.x, button.y)
        mon.write("# #")

        mon.setCursorPos(button.x, button.y + 1)
        mon.write("###")

        mon.setCursorPos(button.x, button.y + 2)
        mon.write("  #")

    end

end

-- ============================================
-- DRAW SCREEN
-- ============================================

local function drawScreen()

    mon.setBackgroundColor(colors.black)
    mon.clear()

    drawButton(1, false)
    drawButton(2, false)
    drawButton(3, false)
    drawButton(4, false)

end

-- ============================================
-- CHECK BUTTON
-- ============================================

local function getButton(x, y)

    for number, button in pairs(buttons) do

        if x >= button.x
            and x < button.x + buttonWidth
            and y >= button.y
            and y < button.y + buttonHeight then

            return number
        end
    end

    return nil
end

-- ============================================
-- OPEN DOOR
-- ============================================

local function openDoor(number)

    local side = doors[number]

    if not side then
        return
    end

    redstone.setOutput(side, true)

    sleep(0.2)

    redstone.setOutput(side, false)

end

-- ============================================
-- START
-- ============================================

drawScreen()

while true do

    local event, side, x, y =
        os.pullEvent("monitor_touch")

    local number = getButton(x, y)

    if number then

        -- Открываем дверь
        openDoor(number)

        -- Цифра становится зелёной
        drawButton(number, true)

        sleep(0.25)

        -- Возвращаем красный цвет
        drawScreen()

    end
end
