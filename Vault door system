-- 4 DOOR CONTROL
-- CC:TWEAKED / CRAFTOS 1.9
-- ============================================

local mon = peripheral.find("monitor")

if not mon then
    error("Monitor not found")
end

mon.setTextScale(1)
mon.setCursorBlink(false)

-- ============================================
-- DOOR CONFIGURATION
-- ============================================

local doors = {
    [1] = {
        name = "Door 1",
        side = "front"
    },

    [2] = {
        name = "Door 2",
        side = "left"
    },

    [3] = {
        name = "Door 3",
        side = "back"
    },

    [4] = {
        name = "Door 4",
        side = "right"
    }
}

-- ============================================
-- MONITOR SIZE
-- ============================================

local width, height = mon.getSize()

-- ============================================
-- BUTTON STORAGE
-- ============================================

local buttons = {}

-- ============================================
-- DRAW BUTTON
-- ============================================

local function drawButton(number, x, y, w, h)

    buttons[number] = {
        x1 = x,
        y1 = y,
        x2 = x + w - 1,
        y2 = y + h - 1
    }

    mon.setBackgroundColor(colors.gray)

    for yy = y, y + h - 1 do
        mon.setCursorPos(x, yy)
        mon.write(string.rep(" ", w))
    end

    local text = tostring(number)

    local tx = x + math.floor((w - #text) / 2)
    local ty = y + math.floor((h - 1) / 2)

    mon.setTextColor(colors.white)
    mon.setCursorPos(tx, ty)
    mon.write(text)
end

-- ============================================
-- DRAW CLOCK LAYOUT
-- ============================================

local function drawScreen()

    mon.setBackgroundColor(colors.black)
    mon.clear()

    buttons = {}

    -- Button size
    local buttonWidth = math.max(5, math.floor(width / 4))
    local buttonHeight = math.max(3, math.floor(height / 4))

    -- Center position
    local centerX = math.floor(width / 2)
    local centerY = math.floor(height / 2)

    -- ========================================
    -- 2 = TOP (12 O'CLOCK)
    -- ========================================

    drawButton(
        2,
        centerX - math.floor(buttonWidth / 2),
        2,
        buttonWidth,
        buttonHeight
    )

    -- ========================================
    -- 1 = LEFT (9 O'CLOCK)
    -- ========================================

    drawButton(
        1,
        1,
        centerY - math.floor(buttonHeight / 2),
        buttonWidth,
        buttonHeight
    )

    -- ========================================
    -- 3 = RIGHT (3 O'CLOCK)
    -- ========================================

    drawButton(
        3,
        width - buttonWidth + 1,
        centerY - math.floor(buttonHeight / 2),
        buttonWidth,
        buttonHeight
    )

    -- ========================================
    -- 4 = BOTTOM (6 O'CLOCK)
    -- ========================================

    drawButton(
        4,
        centerX - math.floor(buttonWidth / 2),
        height - buttonHeight + 1,
        buttonWidth,
        buttonHeight
    )
end

-- ============================================
-- SEND REDSTONE PULSE
-- ============================================

local function openDoor(number)

    local door = doors[number]

    if not door then
        return
    end

    redstone.setOutput(door.side, true)

    sleep(0.2)

    redstone.setOutput(door.side, false)
end

-- ============================================
-- FIND PRESSED BUTTON
-- ============================================

local function getButton(x, y)

    for number, button in pairs(buttons) do

        if x >= button.x1
            and x <= button.x2
            and y >= button.y1
            and y <= button.y2 then

            return number
        end
    end

    return nil
end

-- ============================================
-- MAIN LOOP
-- ============================================

drawScreen()

while true do

    local event, side, x, y = os.pullEvent("monitor_touch")

    local number = getButton(x, y)

    if number then

        openDoor(number)

        -- Visual feedback
        local button = buttons[number]

        mon.setBackgroundColor(colors.green)

        for yy = button.y1, button.y2 do
            mon.setCursorPos(button.x1, yy)
            mon.write(
                string.rep(
                    " ",
                    button.x2 - button.x1 + 1
                )
            )
        end

        local text = tostring(number)

        local tx = button.x1
            + math.floor(
                ((button.x2 - button.x1 + 1) - #text) / 2
            )

        local ty = button.y1
            + math.floor(
                ((button.y2 - button.y1 + 1) / 2)
            )

        mon.setTextColor(colors.white)
        mon.setCursorPos(tx, ty)
        mon.write(text)

        sleep(0.25)

        drawScreen()
    end
end
